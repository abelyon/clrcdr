# Postgres: public proxy URL is preferred (works locally and on Railway).
DATABASE_PUBLIC_URL=
DATABASE_URL=
# Redis (optional locally: the API falls back to in-memory state).
REDIS_PUBLIC_URL=
REDIS_URL=

# apps/api
PORT=4000
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:3000
# Comma separated allowed web origins (alias of CORS_ORIGIN, wins when both are set). Unset = permissive.
WEB_ORIGIN=
# Countdown before a 1v1 match accepts guesses (ms).
MATCH_COUNTDOWN_MS=3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

{
  "name": "@mastermind/api",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify + Socket.io + Redis realtime API for CLRCDR Mastermind.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@mastermind/db": "workspace:*",
    "@mastermind/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
